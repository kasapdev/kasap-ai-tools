# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# env files - never commit real secrets
.env
.env.*
!.env.example

# local runtime data (sqlite db, logs) - matched by extension, not by a
# blanket "data/" directory rule, since several packages have a real
# checked-in data/ folder (e.g. llm-cost-tracker/data/pricing.json) that a
# bare "data/" line would silently exclude from every commit.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log

# editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# test/coverage
coverage/
