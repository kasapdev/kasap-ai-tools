# @kasap/listing-image-bg-remover hiçbir API çağrısı yapmaz (Claude/Anthropic dahil) -
# tamamen yerel, klasik görüntü işleme. Zorunlu bir ortam değişkeni yok.

# Opsiyonel: remove-bg komutunun --tolerance bayrağı verilmediğinde kullanılacak
# varsayılan renk mesafesi toleransı (0-441 arası, RGB Euclidean mesafesi).
BG_REMOVER_DEFAULT_TOLERANCE=24
