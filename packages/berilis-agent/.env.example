# --- Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override - defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=claude-opus-5

# --- Discord ---
# Discord Developer Portal (https://discord.com/developers/applications) >
# your application > Bot > Token. Keep this secret, never commit it.
DISCORD_TOKEN=
# The exact name of the role that should be pinged when the bot escalates
# a question it can't confidently answer. Must match exactly (case-sensitive).
ADMIN_ROLE_NAME=Sistem Yöneticisi
# Comma-separated channel IDs the bot should always answer in
# (right-click a channel > Copy Channel ID; requires Developer Mode on).
# Leave empty to rely only on the ticket channel prefix / @mentions below.
SUPPORT_CHANNEL_IDS=
# Channels whose name starts with this prefix are treated as support tickets.
TICKET_CHANNEL_PREFIX=ticket-
# Optional - restrict the bot to a single guild (not currently enforced, informational).
GUILD_ID=

# --- @kasap/core ---
# Where this project's SQLite store (conversation memory + interaction logs) lives.
CORE_DB_PATH=./data/berilis-agent.sqlite
# RAG stays off until there's real data to index - see packages/core/.env.example.
RAG_ENABLED=false
