# https://console.anthropic.com/settings/keys - only needed for `docs ask` / `docs index`,
# not for the plain SDK calls (servers/player/...).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Where this project's SQLite store (interaction logs) lives.
CORE_DB_PATH=./data/truckersmp-sdk.sqlite

# RAG stays off until there's real data to index - see packages/core/.env.example.
RAG_ENABLED=false
