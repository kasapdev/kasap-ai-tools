# https://console.anthropic.com/settings/keys - only needed for `ask`,
# not for `index` (that command never calls Claude, only embeddings via RAG).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Where this project's SQLite store (interaction logs) lives.
CORE_DB_PATH=./data/repo-doc-chatbot.sqlite

# RAG stays off until there's real data to index - see packages/core/.env.example.
# `ask` works fine with this false (falls back to direct file-excerpt grounding).
# `index` requires RAG_ENABLED=true and chromadb/voyageai installed in @kasap/core.
RAG_ENABLED=false
