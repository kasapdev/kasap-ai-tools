# @kasap/core is a shared library, not a standalone app - it does not load
# .env itself. These are the variables it reads from process.env; each
# consuming project (berilis-agent, roblox-ai, ...) loads its own .env at
# startup (via dotenv), and these values should live there. Listed here as
# documentation of what core understands.

# Anthropic API key. Leave unset if you use `ant auth login` instead.
ANTHROPIC_API_KEY=

# Claude model id used by default when a caller doesn't override it.
ANTHROPIC_MODEL=claude-opus-5

# Where the shared SQLite store (conversation memory + interaction logs) lives.
# Each project should point this at its own file so logs don't mix.
CORE_DB_PATH=./data/core.sqlite

# --- RAG (inactive until you have data worth indexing) ---
# Set to "true" once you're ready to activate retrieval. Until then,
# retrieveContext() always returns [] and no RAG deps are required.
RAG_ENABLED=false

# Chroma server URL (see https://docs.trychroma.com/guides to run one).
# Only required when RAG_ENABLED=true. Requires: pnpm add chromadb --filter @kasap/core
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=kasap-knowledge

# Voyage AI embeddings. Only required when RAG_ENABLED=true.
# Requires: pnpm add voyageai --filter @kasap/core
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
